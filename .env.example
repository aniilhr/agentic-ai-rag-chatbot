# --- Required -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key
# Separate index for Gemini vectors (3072-d). Do not point this at an index
# built with OpenAI embeddings (1536-d); ingestion refuses a dimension mismatch.
PINECONE_INDEX_NAME=agentic-ai-gemini-index

# --- Optional (defaults shown) --------------------------------------------
# PINECONE_NAMESPACE=agentic-ai-ebook
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 returns 3072-d vectors by default (768 / 1536 also
# supported); changing this requires a new Pinecone index and re-ingestion.
# EMBEDDING_DIMENSION=3072
# LLM_MODEL=gemini-2.5-flash
# PDF_PATH=data/Ebook-Agentic-AI.pdf
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
# Minimum cosine similarity of the best chunk before the LLM is even called.
# RELEVANCE_THRESHOLD=0.50
# Cosine range rescaled onto the 0..1 retrieval score.
# SIMILARITY_FLOOR=0.50
# SIMILARITY_CEILING=0.80
